{"nodes": [{"id": "$graphify-root$_design_md", "label": "DESIGN.md", "file_type": "document", "node_kind": "page", "source_file": "DESIGN.md", "source_location": "L1"}, {"id": "$graphify-root$_design_render_style_reference", "label": "Render \u2014 Style Reference", "file_type": "document", "node_kind": "heading", "source_file": "DESIGN.md", "source_location": "L1"}, {"id": "$graphify-root$_design_tokens_colors", "label": "Tokens \u2014 Colors", "file_type": "document", "node_kind": "heading", "source_file": "DESIGN.md", "source_location": "L12"}, {"id": "$graphify-root$_design_tokens_typography", "label": "Tokens \u2014 Typography", "file_type": "document", "node_kind": "heading", "source_file": "DESIGN.md", "source_location": "L31"}, {"id": "$graphify-root$_design_ppneuemontreal_ui_and_body_text_the_workhorse_grotesque_used_for_nav_buttons_body_copy_and_all_functional_interface_elements_the_tight_tracking_at_small_sizes_0_01em_at_12px_and_slight_loosening_at_larger_sizes_0_02em_at_24px_create_optical_balance_across_the_ui_scale_weight_400_is_the_default_weight_500_appears_in_nav_links_and_button_labels_where_a_subtle_emphasis_is_needed_without_switching_faces_font_ppneuemontreal", "label": "PPNeueMontreal \u2014 UI and body text \u2014 the workhorse grotesque used for nav, buttons, body copy, and all functional interface elements. The tight tracking at small sizes (-0.01em at 12px) and slight loosening at larger sizes (0.02em at 24px) create optical balance across the UI scale. Weight 400 is the default; weight 500 appears in nav links and button labels where a subtle emphasis is needed without switching faces. \u00b7 `--font-ppneuemontreal`", "file_type": "document", "node_kind": "heading", "source_file": "DESIGN.md", "source_location": "L33"}, {"id": "$graphify-root$_design_roobert_display_and_heading_text_used_for_hero_headlines_section_titles_and_all_oversized_type_the_signature_choice_is_weight_300_for_the_largest_sizes_64_80px_which_is_anti_convention_most_sites_use_600_700_for_impact_but_render_uses_whisper_weight_to_achieve_authority_through_restraint_line_heights_compress_to_1_00_1_10_at_display_sizes_creating_tight_architectural_headlines_tracking_tightens_aggressively_with_size_0_03em_at_80px_to_compensate_for_the_visual_airiness_of_light_weight_font_roobert", "label": "Roobert \u2014 Display and heading text \u2014 used for hero headlines, section titles, and all oversized type. The signature choice is weight 300 for the largest sizes (64-80px), which is anti-convention \u2014 most sites use 600-700 for impact, but Render uses whisper-weight to achieve authority through restraint. Line-heights compress to 1.00-1.10 at display sizes, creating tight, architectural headlines. Tracking tightens aggressively with size (-0.03em at 80px) to compensate for the visual airiness of light weight. \u00b7 `--font-roobert`", "file_type": "document", "node_kind": "heading", "source_file": "DESIGN.md", "source_location": "L41"}, {"id": "$graphify-root$_design_ppneuemontrealmono_code_and_technical_labels_the_monospaced_face_for_terminal_badges_code_snippets_and_developer_facing_metadata_the_slight_positive_tracking_0_02_0_025em_is_typical_for_mono_at_small_sizes_to_improve_readability_of_technical_strings_used_in_elements_like_the_git_push_badge_and_command_labels_font_ppneuemontrealmono", "label": "PPNeueMontrealMono \u2014 Code and technical labels \u2014 the monospaced face for terminal badges, code snippets, and developer-facing metadata. The slight positive tracking (0.02-0.025em) is typical for mono at small sizes to improve readability of technical strings. Used in elements like the '$ git push' badge and command labels. \u00b7 `--font-ppneuemontrealmono`", "file_type": "document", "node_kind": "heading", "source_file": "DESIGN.md", "source_location": "L49"}, {"id": "$graphify-root$_design_type_scale", "label": "Type Scale", "file_type": "document", "node_kind": "heading", "source_file": "DESIGN.md", "source_location": "L57